# Database Configuration (Required for Spring Boot Backend)
MYSQL_URL=jdbc:mysql://localhost:3306/portfolio_stockmarket
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200

# JWT Configuration
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRATION_MS=86400000

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# OAUTH2_REDIRECT_URI: Frontend URL where the backend redirects the browser with the JWT token after login
# Local: http://localhost:4200/oauth2/redirect | Production: https://portfolio-stock-market.vercel.app/oauth2/redirect
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/redirect
# GOOGLE_REDIRECT_URI (optional): Override Google OAuth callback if needed (defaults to dynamic {baseUrl}/login/oauth2/code/google)
# GOOGLE_REDIRECT_URI=https://portfoliostockmarket-production.up.railway.app/login/oauth2/code/google

# Twelve Data Market Data Configuration
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Upstox API Configuration (Indian Market Data)
UPSTOX_CLIENT_ID=your_upstox_client_id
UPSTOX_CLIENT_SECRET=your_upstox_client_secret
UPSTOX_REDIRECT_URI=http://localhost:8080/api/upstox/callback
